# Copy these names into Vercel > Project > Settings > Environment Variables.
# NEVER put real keys in GitHub or in any file inside /public.

# Payment gate (Razorpay). Start with TEST keys (rzp_test_...), switch to LIVE later.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only if you create a Razorpay webhook (see README)
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_text

# Price of one ad in rupees (the server decides the price, not the browser)
PRICE_INR=99

# Password for the Insights page. Choose something long.
ADMIN_KEY=choose_a_long_password

# AI poster + AI insights (optional; the poster studio still works without it)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Database: add "Upstash for Redis" from the Vercel Marketplace (Storage tab).
# It adds these automatically (names may start with KV_ instead of UPSTASH_):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
